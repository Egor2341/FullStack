# ---- Database (Postgres) ----
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=treasurydb

# ---- Auth ----
JWT_SECRET_KEY=change_me_to_a_long_random_value

# ---- MinIO ----
MINIO_ENDPOINT=minio:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=change_me
MINIO_SECURE=false
MINIO_BUCKET=receipts

# ---- Alpha Vantage ----
ALPHA_VANTAGE_API_KEY=change_me
ALPHA_VANTAGE_URL=https://www.alphavantage.co/query
REQUEST_TIMEOUT=5

# ---- App / CORS / Public URLs ----
# Frontend origin(s) that can call the API (comma-separated)
CORS_ORIGINS=http://localhost:8080

# Used for sitemap/robots links
PUBLIC_BASE_URL=http://localhost:8080
