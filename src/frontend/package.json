{
  "name": "treasury",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "20.20.2",
    "npm": "10.8.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "prettify": "prettier --loglevel warn --cache --write \"src/**/*.{ts,tsx,js,json,yml,scss}\" \"*.{ts,tsx,js,json,yml,scss}\" \"!**/{node_modules,dist}/**/*\""
  },
  "dependencies": {
    "axios": "1.15.0",
    "jwt-decode": "4.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-helmet-async": "3.0.0",
    "react-icons": "5.6.0",
    "react-router-dom": "7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.11.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/testing-library__jest-dom": "5.14.9",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "9.39.3",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "29.0.2",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "4.1.4"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.1.14"
    }
  }
}
