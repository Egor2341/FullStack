@startuml activity-main-process
!pragma layout smetana
skinparam defaultFontName "Segoe UI"
skinparam shadowing false
title Основной бизнес-процесс: учёт расхода и сверка с бюджетом

start
:Открыть приложение;
if (Есть учётная запись?) then (нет)
  :Зарегистрироваться\nпо email и паролю;
else (да)
endif
:Войти в систему;
:Открыть раздел «Расходы»;
:Выбрать категорию расхода;
if (Категория выбрана?) then (нет)
  :Показать сообщение\n«Выберите категорию»;
  stop
else (да)
endif
:Ввести сумму расхода;
if (Сумма корректна?) then (нет)
  :Показать сообщение об ошибке;\nзапись не создаётся;
  stop
else (да)
endif
:Сохранить расход;
if (Расход с такой категорией\nуже существует?) then (да)
  :Показать сообщение\n«This expense already exist»;\nвторая запись не создаётся;
  stop
else (нет)
endif
:Пересчитать фактический бюджет\nкак доходы минус расходы;
:Открыть раздел «Бюджеты»;
if (Нужно задать план?) then (да)
  :Ввести плановую сумму\nна месяц;
else (нет)
endif
:Сравнить плановый и фактический бюджет;
:Выйти из системы;
stop
@enduml
